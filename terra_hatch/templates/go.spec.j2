# https://{{ goipath }}
%global goipath         {{ goipath }}
Version:                {{ version }}

%gometa -f

%global common_description %{expand:
{{ description }}}

%global golicenses      {{ licenses }}
%global godocs          {{ docs }}

Name:           {{ name }}
Release:        1%{?dist}
Summary:        {{ summary }}
URL:            %{gourl}
Source:         %{gosource}
License:        {{ license }}
BuildRequires:  go-rpm-macros
BuildRequires:  go-srpm-macros
BuildRequires:  anda-srpm-macros

Packager:       {{ packager }}

%description %{common_description}

%gopkg

%prep
%autosetup -C
%goprep_online -A

%build
# TODO: confirm this builds the intended binary
%gobuild -o %{gobuilddir}/bin/%{name} {{ gobuild_path }}

%install
%gopkginstall
install -m 0755 -vd %{buildroot}%{_bindir}
install -m 0755 -vp %{gobuilddir}/bin/%{name} %{buildroot}%{_bindir}/

%files
%license {{ licenses }}
%doc {{ docs }}
%{_bindir}/%{name}

%gopkgfiles

{{ changelog }}
