# Generated by terra-hatch (upstream: {{ upstream }}). Review every TODO before use.
Name:           {{ name }}
Version:        {{ version }}
Release:        1%{?dist}
Summary:        {{ summary }}
License:        {{ license }}
URL:            {{ url }}
{% if source_url %}
Source0:        {{ source_url }}
{% else %}
# TODO: Source0 — set the tarball URL of the release tag (unpacked dir: %{name}-%{version})
{% endif %}
SourceLicense:  {{ source_license }}
BuildRequires:  cargo
BuildRequires:  anda-srpm-macros
BuildRequires:  cargo-rpm-macros
# TODO: add remaining BuildRequires found by building the crate

Packager:       {{ packager }}

%description
{{ description }}

%prep
%autosetup -n %{name}-%{version}
%cargo_prep_online

%build
%cargo_build

%install
install -Dm755 target/rpm/{{ name }} %{buildroot}%{_bindir}/{{ name }}
%cargo_license_summary_online
%{cargo_license_online -a} > LICENSE.dependencies

%files
%doc {{ docs }}
%license {{ licenses }}
%license LICENSE.dependencies
%{_bindir}/{{ name }}

{{ changelog }}
